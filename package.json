{
  "name": "aiwaf-monorepo",
  "private": true,
  "scripts": {
    "test": "python aiwaf_test.py",
    "test:coverage": "python aiwaf_test.py --coverage",
    "test:coverage:strict": "python aiwaf_test.py --strict-function-coverage",
    "test:python": "python aiwaf_test.py --python-only",
    "test:rust": "python aiwaf_test.py --rust-only",
    "test:js": "python aiwaf_test.py --js-only",
    "test:wasm": "python aiwaf_test.py --wasm-only",
    "pack:js": "npm pack ./js --dry-run"
  }
}
